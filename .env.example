# Copy to .env (git-ignored). `make` reads it automatically.
# PostgreSQL (recommended). See docs/SETUP_POSTGRES.md
DATABASE_URL=postgresql+psycopg://fieldwise:fieldwise@127.0.0.1:5432/fieldwise
# Leave DATABASE_URL unset to use a local SQLite file instead (fieldwise.db).

# Listen address. Keep 127.0.0.1 unless you mean to open it to your network.
FIELDWISE_HOST=127.0.0.1
FIELDWISE_PORT=8000

# Signs the demo session cookie. Change it if you run this anywhere but your own laptop.
FIELDWISE_SECRET=change-me
# Run the test suite on PostgreSQL instead of temporary SQLite files:
# FIELDWISE_TEST_DATABASE_URL=postgresql+psycopg://fieldwise:fieldwise@127.0.0.1:5432/fieldwise_test
