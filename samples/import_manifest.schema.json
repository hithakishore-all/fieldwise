{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fieldwise import manifest",
  "description": "Structured manual passages. The tenant comes from the uploader's session, never from this file.",
  "type": "object",
  "required": ["records"],
  "properties": {
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sourceId", "externalId", "title", "model", "revision", "status", "passages"],
        "properties": {
          "sourceId": {"type": "string", "description": "Short public ID for this manual revision, e.g. MB2"},
          "externalId": {"type": "string", "description": "Your system's ID; unique within your tenant"},
          "title": {"type": "string"},
          "model": {"type": "string"},
          "revision": {"type": "string"},
          "status": {"enum": ["current", "superseded"]},
          "passages": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["locator", "page", "text"],
              "properties": {
                "locator": {"type": "string", "pattern": "^p[0-9]{1,4}$"},
                "page": {"type": "integer", "minimum": 1},
                "text": {"type": "string", "minLength": 1},
                "faultCodes": {"type": "array", "items": {"type": "string"}, "description": "Aliases are normalized, e.g. D-17 → D17"},
                "topic": {"type": "string", "description": "Used by templates to bind slots, e.g. indicator, self-test"}
              }
            }
          }
        }
      }
    }
  }
}
